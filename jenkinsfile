pipeline {
    agent any

    environment {
        REPO_URL = 'https://github.com/Javierfloresr31/projectdevopsjava.git'
        IMAGE_NAME = 'javierfloresr31/myapp'
    }

    stages {
        stage('Checkout') {
            steps {
                echo '=== Etapa: Checkout ==='
                echo 'Clonando https://github.com/Javierfloresr31/projectdevopsjava'
                sh '''
                    rm -rf projectdevopsjava
                    git clone --depth 1 --branch main "${REPO_URL}" projectdevopsjava
                '''
                script {
                    env.COMMIT = sh(script: 'git -C projectdevopsjava rev-parse HEAD', returnStdout: true).trim()
                }
                echo "Repositorio clonado. Commit: ${env.COMMIT}"
            }
        }

        stage('Build Image') {
            steps {
                echo '=== Etapa: Build de imagen Docker ==='
                dir('projectdevopsjava') {
                    sh 'docker build -t "${IMAGE_NAME}:${COMMIT}" .'
                }
                echo "Imagen ${env.IMAGE_NAME}:${env.COMMIT} creada"
            }
        }

        stage('Push Docker Hub') {
            steps {
                echo '=== Etapa: Push a Docker Hub ==='
                sh 'docker push "${IMAGE_NAME}:${COMMIT}"'
                echo "Imagen publicada: ${env.IMAGE_NAME}:${env.COMMIT}"
            }
        }

        

    }

    post {
        success {
            echo '=== Pipeline completado: imagen publicada y desplegada ==='
        }
        failure {
            echo '=== Pipeline fallo ==='
            echo 'Revisar logs para mas detalles'
        }
        always {
            sh 'rm -rf projectdevopsjava || true'
            echo '=== Pipeline finalizado ==='
        }
    }
}
