# Terraform working directories and downloaded providers
**/.terraform/*
.terraform/

# Terraform state files (may contain sensitive values)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform plan files and saved plans
*.tfplan
tfplan
tfplan.*

# Terraform crash logs
crash.log
crash.*.log

# Local Terraform CLI configuration
.terraformrc
terraform.rc

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform state lock information
.terraform.tfstate.lock.info

# Variable files: may contain environment-specific values and secrets.
# Keep only explicitly named examples under version control.
*.tfvars
*.tfvars.json
!terraform.tfvars.example
!*.auto.tfvars.example

# Local environment files and secrets
.env
.env.*
!.env.example
*.local
*.local.*
secrets/
credentials/
*.secret
*.pem
*.key
*.p12
*.pfx

# SSH private keys and generated key pairs
id_rsa*
id_ed25519*
id_ecdsa*
*.ppk
*.pub

# Jenkins local data / backups
jenkins_home/
jenkins_home_*/
*.jpi
*.hpi

# Logs and temporary files
*.log
*.tmp
*.bak
*.swp
*.swo
*~

# OS / editor files
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
